{
  "name": "markdown-mermaid-renderer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "bun build src/app.ts --outdir dist --target browser --minify && bun build src/server.ts --outfile dist/server.js --target bun --minify",
    "check": "bunx tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "markdown-it-anchor": "^9.2.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "type-fest": "^5.8.0",
    "typescript": "^7.0.2"
  }
}
